/*
 * Allow PC/SC access for the plugdev group.
 *
 * pcscd uses polkit to authorize clients. On headless machines or over SSH
 * there is no active local session, so the default policy denies
 * org.debian.pcsc-lite.access_pcsc and access_card. Install this file as
 * /etc/polkit-1/rules.d/50-pcscd.rules and restart polkit.
 *
 * Scope: members of plugdev, the usual group for removable devices.
 * Remove the file to restore the default policy.
 */
polkit.addRule(function(action, subject) {
    if ((action.id == "org.debian.pcsc-lite.access_pcsc" ||
         action.id == "org.debian.pcsc-lite.access_card") &&
        subject.isInGroup("plugdev")) {
        return polkit.Result.YES;
    }
});
